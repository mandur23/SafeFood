<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safefood.view.controller.ProfileController">

    <top>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
            <Button text="1. 메뉴 선택" styleClass="nav-button" onAction="#handleMain"/>
            <Button text="2. 내 정보" styleClass="nav-button, active"/>
            <Button text="3. 기록" styleClass="nav-button" onAction="#handleHistory"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="사용자님 로그인 중" styleClass="sub"/>
            <Button text="로그아웃" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox alignment="TOP_CENTER" styleClass="screen" spacing="16">
                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>

                <VBox maxWidth="900" spacing="16">

                    <VBox spacing="4">
                        <Label text="내 프로필" styleClass="page-title"/>
                        <Label text="등록한 알레르기와 취향을 확인하고 바꿀 수 있습니다."
                               styleClass="page-subtitle"/>
                        <Separator/>
                    </VBox>

                    <VBox styleClass="card">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="계정" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="닉네임 / 비밀번호 변경" styleClass="outline"
                                    onAction="#handleEditInfo"/>
                        </HBox>
                    </VBox>

                    <VBox styleClass="card" spacing="10">
                        <Label text="보유 알레르기" styleClass="section-title"/>
                        <Label text="X를 누르면 목록에서 빠집니다." styleClass="sub"/>
                        <FlowPane fx:id="ownedPane" styleClass="chip-area" hgap="8" vgap="8"/>

                        <HBox spacing="8">
                            <TextField fx:id="searchField" promptText="알레르기 이름으로 검색 (예: 고등어)"
                                       HBox.hgrow="ALWAYS"/>
                            <Button text="검색" onAction="#handleSearch"/>
                        </HBox>

                        <Label text="심각도 — 높을수록 혼입 가능(POSSIBLE) 메뉴의 순위를 크게 낮춥니다"
                               styleClass="field-label" wrapText="true"/>
                        <FlowPane fx:id="severityPane" styleClass="chip-area" hgap="8" vgap="8"/>

                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="알레르기 추가 저장" styleClass="primary" onAction="#handleAddAllergy"/>
                        </HBox>
                    </VBox>

                    <VBox styleClass="card" spacing="10">
                        <Label text="음식 취향" styleClass="section-title"/>
                        <FlowPane fx:id="categoryPane" styleClass="chip-area" hgap="8" vgap="8"/>

                        <Label text="예산 범위" styleClass="field-label"/>
                        <Label fx:id="priceLabel" text="8,000원 ~ 15,000원" styleClass="accent-text"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="하한" styleClass="sub" minWidth="30"/>
                            <Slider fx:id="priceMin" min="0" max="30000" value="8000" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="상한" styleClass="sub" minWidth="30"/>
                            <Slider fx:id="priceMax" min="0" max="30000" value="15000" HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <VBox spacing="4">
                            <Label text="최대 탐색 거리" styleClass="field-label"/>
                            <ComboBox fx:id="distanceBox" maxWidth="Infinity"/>
                        </VBox>

                        <Label text="선호 맵기" styleClass="field-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="안매움(0)" styleClass="sub"/>
                            <Slider fx:id="spicySlider" min="0" max="5" value="3"
                                    majorTickUnit="1" minorTickCount="0" snapToTicks="true"
                                    showTickMarks="true" HBox.hgrow="ALWAYS"/>
                            <Label text="최강매움(5)" styleClass="sub"/>
                            <Label fx:id="spicyValue" text="3단계" styleClass="accent-text" minWidth="60"/>
                        </HBox>
                    </VBox>

                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="취향 및 조건 저장" styleClass="primary" onAction="#handleSave"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
