<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safefood.view.controller.GroupConditionController"
            fx:id="root" fitToWidth="true" prefWidth="660" prefHeight="620">
    <VBox styleClass="screen" spacing="16">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <VBox spacing="4">
            <Label text="그룹 조건 입력" styleClass="page-title"/>
            <Label text="이 모임에서 적용할 조건을 확인해 주세요." styleClass="page-subtitle" wrapText="true"/>
            <Separator/>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="보유 알레르기" styleClass="section-title"/>
            <Label text="한 명이라도 못 먹는 메뉴는 후보에서 빠집니다. 빠짐없이 골라 주세요."
                   styleClass="sub" wrapText="true"/>
            <FlowPane fx:id="allergyPane" styleClass="chip-area" hgap="8" vgap="8"/>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="매운맛 한계" styleClass="section-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="안매움(0)" styleClass="sub"/>
                <Slider fx:id="spicySlider" min="0" max="5" value="2"
                        majorTickUnit="1" minorTickCount="0" snapToTicks="true"
                        showTickMarks="true" HBox.hgrow="ALWAYS"/>
                <Label text="최강매움(5)" styleClass="sub"/>
                <Label fx:id="spicyValue" text="2단계" styleClass="accent-text" minWidth="60"/>
            </HBox>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="예산 상한" styleClass="section-title"/>
            <Label text="이 모임에서 쓸 수 있는 1인 예산입니다." styleClass="sub"/>
            <ComboBox fx:id="budgetBox" maxWidth="Infinity"/>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="내 위치 (선택)" styleClass="section-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="내 위치 가져오기" onAction="#handlePickLocation"/>
                <Label fx:id="locationLabel" text="아직 설정하지 않았습니다." styleClass="sub"/>
            </HBox>
        </VBox>

        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="준비 완료" styleClass="primary" onAction="#handleReady"/>
        </HBox>
    </VBox>
</ScrollPane>
