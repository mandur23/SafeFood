<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.safefood.view.controller.RestaurantDetailController"
      fx:id="root" prefWidth="720" styleClass="screen" spacing="16">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="2">
        <Label fx:id="restaurantName" styleClass="page-title"/>
        <Label fx:id="menuName" styleClass="restaurant-name"/>
        <Separator/>
    </VBox>

    <StackPane fx:id="mapArea" styleClass="panel" prefHeight="260">
        <Label text="지도 영역&#10;(WebView + 지도 API JS SDK)" styleClass="sub" textAlignment="CENTER"/>
    </StackPane>

    <Label text="추천 근거" styleClass="section-title"/>
    <TextArea fx:id="reasonArea" editable="false" wrapText="true" prefRowCount="3"
              styleClass="readonly"/>

    <VBox styleClass="card" spacing="10">
        <VBox spacing="4">
            <Label text="주소" styleClass="field-label"/>
            <Label fx:id="addressLabel"/>
        </VBox>
        <VBox spacing="4">
            <Label text="영업시간" styleClass="field-label"/>
            <Label fx:id="hoursLabel"/>
        </VBox>
        <VBox spacing="4">
            <Label text="평점" styleClass="field-label"/>
            <Label fx:id="ratingLabel"/>
        </VBox>
    </VBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <ToggleButton fx:id="favoriteButton" text="♡ 찜하기" styleClass="chip"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="길찾기" onAction="#handleRoute"/>
        <Button text="닫기" styleClass="primary" onAction="#handleClose"/>
    </HBox>
</VBox>
