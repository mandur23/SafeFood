<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safefood.view.controller.HistoryController">

    <fx:define>
        <ToggleGroup fx:id="tabGroup"/>
    </fx:define>

    <top>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
            <Button text="1. 메뉴 선택" styleClass="nav-button" onAction="#handleMain"/>
            <Button text="2. 내 정보" styleClass="nav-button" onAction="#handleProfile"/>
            <Button text="3. 기록" styleClass="nav-button, active"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" text="사용자님 로그인 중" styleClass="sub"/>
            <Button text="로그아웃" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="screen" spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="4">
                <Label text="나의 기록" styleClass="page-title"/>
                <Label text="먹은 기록과 찜한 가게를 확인합니다." styleClass="page-subtitle"/>
                <Separator/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT">
                    <ToggleButton fx:id="historyTab" text="히스토리" selected="true"
                                  toggleGroup="$tabGroup" styleClass="tab-toggle, first"/>
                    <ToggleButton fx:id="favoriteTab" text="즐겨찾기"
                                  toggleGroup="$tabGroup" styleClass="tab-toggle, last"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="상태별 보기" styleClass="field-label"/>
                <ComboBox fx:id="filterBox"/>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <ListView fx:id="historyList"/>
                <ListView fx:id="favoriteList" visible="false" managed="false"/>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
