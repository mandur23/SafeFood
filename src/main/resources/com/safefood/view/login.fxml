<?xml version="1.0" encoding="UTF-8"?>

<!--
  1c 로그인 — 탭 대신 두 길을 나란히.

  예전에는 회원/게스트가 토글 탭이라 게스트로 가려면 탭을 한 번 누르고 시작해야 했습니다.
  지금은 둘이 같이 보여서, 게스트는 이름 + 초대 코드만 넣고 바로 방으로 갑니다.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.safefood.view.controller.LoginController"
      alignment="TOP_CENTER" styleClass="screen" spacing="24">
    <padding>
        <Insets top="44" right="40" bottom="40" left="40"/>
    </padding>

    <VBox maxWidth="700" spacing="24">

        <VBox alignment="CENTER" spacing="6">
            <Label text="S" styleClass="brand-mark, large"/>
            <Label text="SafeFood" styleClass="display-title"/>
            <Label text="오늘 뭐 먹지? 고민을 대신 해드려요" styleClass="page-subtitle"/>
        </VBox>

        <HBox spacing="18" alignment="TOP_CENTER">

            <!-- ── 회원 로그인 ─────────────────────────────── -->
            <VBox styleClass="card, soft, elev" spacing="12" HBox.hgrow="ALWAYS"
                  prefWidth="360">
                <Label text="회원 로그인" styleClass="section-title"/>

                <VBox spacing="4">
                    <Label text="아이디" styleClass="field-label"/>
                    <TextField fx:id="idField" promptText="아이디"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="비밀번호" styleClass="field-label"/>
                    <PasswordField fx:id="passwordField" promptText="비밀번호"/>
                </VBox>

                <Label fx:id="memberError" styleClass="error-text" wrapText="true"
                       visible="false" managed="false"/>

                <Button text="로그인" styleClass="primary" maxWidth="Infinity"
                        onAction="#handleLogin"/>

                <HBox spacing="4" alignment="CENTER">
                    <Label text="처음이신가요?" styleClass="sub"/>
                    <Hyperlink text="회원가입" onAction="#handleSignUp"/>
                </HBox>
            </VBox>

            <!-- ── 게스트 ──────────────────────────────────── -->
            <VBox styleClass="card, accent2" spacing="12" HBox.hgrow="ALWAYS"
                  prefWidth="300">
                <Label text="게스트로 바로 참여" styleClass="section-title"/>
                <Label text="가입 없이 이름만으로 그룹 방에 들어가요." styleClass="sub" wrapText="true"/>

                <VBox spacing="4">
                    <Label text="이름" styleClass="field-label"/>
                    <TextField fx:id="nameField" promptText="홍길동"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="초대 코드 (선택)" styleClass="field-label"/>
                    <TextField fx:id="guestCodeField" promptText="6WMK4-2A0P8-Q3XN"/>
                </VBox>

                <Label fx:id="guestError" styleClass="error-text" wrapText="true"
                       visible="false" managed="false"/>

                <Button text="방으로 입장 →" styleClass="primary-2" maxWidth="Infinity"
                        onAction="#handleGuest"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>
