<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.safefood.view.controller.GroupOptionController"
      fx:id="root" prefWidth="420" styleClass="screen" spacing="16">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="4">
        <Label text="같이 먹기" styleClass="page-title"/>
        <Label text="방을 새로 만들지, 전달받은 주소로 참여할지 고르세요."
               styleClass="page-subtitle" wrapText="true"/>
        <Separator/>
    </VBox>

    <VBox styleClass="card" spacing="10">
        <Button text="방 만들기" styleClass="primary" maxWidth="Infinity" onAction="#handleCreate"/>
        <Label text="내가 서버가 되어 방을 엽니다. 접속 주소와 초대 코드를 일행에게 전달하세요."
               styleClass="sub" wrapText="true"/>

        <Button text="방 참여하기" maxWidth="Infinity" onAction="#handleJoin"/>
        <Label text="전달받은 접속 주소와 초대 코드로 방장 서버에 접속합니다."
               styleClass="sub" wrapText="true"/>
    </VBox>
</VBox>
