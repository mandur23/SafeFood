<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safefood.view.controller.OnboardingController"
            fitToWidth="true">
    <VBox alignment="TOP_CENTER" styleClass="screen" spacing="16">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <VBox maxWidth="860" spacing="16">

            <VBox spacing="4">
                <Label text="초기 취향 및 알레르기 온보딩 설문" styleClass="page-title"/>
                <Label text="추천에 필요한 최소 조건만 받습니다. 나중에 내 프로필에서 바꿀 수 있습니다."
                       styleClass="page-subtitle" wrapText="true"/>
                <Separator/>
            </VBox>

            <VBox styleClass="card" spacing="10">
                <Label text="매운맛 선호 정도" styleClass="section-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="안매움(0)" styleClass="sub"/>
                    <Slider fx:id="spicySlider" min="0" max="5" value="2"
                            majorTickUnit="1" minorTickCount="0" snapToTicks="true"
                            showTickMarks="true" HBox.hgrow="ALWAYS"/>
                    <Label text="최강매움(5)" styleClass="sub"/>
                    <Label fx:id="spicyValue" text="2단계" styleClass="accent-text" minWidth="60"/>
                </HBox>
            </VBox>

            <VBox styleClass="card" spacing="10">
                <Label text="선호 음식 종류" styleClass="section-title"/>
                <Label text="여러 개 고를 수 있습니다." styleClass="sub"/>
                <FlowPane fx:id="categoryPane" styleClass="chip-area" hgap="8" vgap="8"/>
            </VBox>

            <VBox styleClass="card" spacing="10">
                <Label text="예산과 거리" styleClass="section-title"/>
                <VBox spacing="4">
                    <Label text="한끼 예산 상한" styleClass="field-label"/>
                    <ComboBox fx:id="budgetBox" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="최대 탐색 거리" styleClass="field-label"/>
                    <ComboBox fx:id="distanceBox" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <VBox styleClass="card" spacing="10">
                <Label text="보유 알레르기 등록" styleClass="section-title"/>
                <Label text="식약처 고시 표시 대상 19종입니다. 해당하는 것을 모두 고르세요." styleClass="sub"/>
                <FlowPane fx:id="allergyPane" styleClass="chip-area" hgap="8" vgap="8"/>

                <VBox fx:id="severityBox" spacing="6"/>
            </VBox>

            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="추천 알고리즘 시작 →" styleClass="primary" onAction="#handleStart"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
