<?xml version="1.0" encoding="UTF-8"?>

<!--
  1b 그룹 대기실 — 소켓 로그를 말풍선·시스템 알림으로, 투표는 우측 패널로.

  예전에는 참여자 표 + 검은 콘솔 + 후보 목록이 나란히 있었습니다. 지금은 왼쪽이 대화 흐름
  (참여·준비·병합·확정이 전부 이 흐름 안에서 알려집니다), 오른쪽이 사람과 투표입니다.
  프로토콜 원문은 맨 아래 '소켓 로그'를 펴면 그대로 볼 수 있습니다.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safefood.view.controller.WaitingRoomController">

    <!-- ── 머리 ─────────────────────────────────────────────── -->
    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="toolbar, divided">
            <Label text="그룹 대기실" styleClass="section-title"/>
            <Label fx:id="memberTag" styleClass="tag, accent"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="codeLabel" styleClass="code-inline"/>
            <Button fx:id="copyButton" text="복사" styleClass="ghost-quiet" onAction="#handleCopyCode"/>
            <Button fx:id="closeRoomButton" text="방 종료" styleClass="danger"
                    onAction="#handleCloseRoom"/>
        </HBox>
    </top>

    <center>
        <HBox alignment="TOP_LEFT">

            <!-- ── 대화 흐름 ─────────────────────────────────── -->
            <VBox HBox.hgrow="ALWAYS" prefWidth="620">
                <ScrollPane fx:id="chatScroll" styleClass="chat-scroll"
                            fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox fx:id="chatBox" spacing="10">
                        <padding>
                            <Insets top="18" right="22" bottom="18" left="22"/>
                        </padding>
                    </VBox>
                </ScrollPane>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="14" right="22" bottom="14" left="22"/>
                    </padding>
                    <TextField fx:id="chatInput" promptText="메시지 보내기…"
                               HBox.hgrow="ALWAYS" onAction="#handleSend"/>
                    <Button text="➤" styleClass="icon-send" onAction="#handleSend"/>
                </HBox>
            </VBox>

            <Region styleClass="rule-v"/>

            <!-- ── 사람과 투표 ───────────────────────────────── -->
            <VBox styleClass="panel" spacing="14" prefWidth="360" minWidth="320">
                <padding>
                    <Insets top="18" right="22" bottom="18" left="22"/>
                </padding>

                <FlowPane fx:id="avatarRow" hgap="10" vgap="10"/>

                <Region styleClass="rule"/>

                <Label fx:id="voteTitle" text="투표" styleClass="section-title"/>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox fx:id="candidateBox" spacing="10"/>
                </ScrollPane>

                <Button fx:id="resultButton" text="최종 확정" styleClass="primary"
                        maxWidth="Infinity" onAction="#handleResult"/>

                <!-- 프로토콜 원문 — 평소에는 접혀 있습니다 -->
                <TitledPane text="소켓 로그" expanded="false">
                    <ScrollPane fx:id="console" styleClass="console" fitToWidth="true"
                                prefHeight="160">
                        <VBox fx:id="logBox" spacing="2">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                        </VBox>
                    </ScrollPane>
                </TitledPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>
