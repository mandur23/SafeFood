<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safefood.view.controller.WaitingRoomController"
            fitToWidth="true" fitToHeight="true">

    <VBox styleClass="screen" spacing="16">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <VBox spacing="4">
            <Label text="그룹 대기실" styleClass="page-title"/>
            <Label text="참여자가 모두 준비되면 조건을 합쳐 추천을 돌립니다."
                   styleClass="page-subtitle" wrapText="true"/>
            <Separator/>
        </VBox>

        <HBox spacing="16" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">

            <VBox spacing="12" prefWidth="440" minWidth="360">
                <Label text="접속자" styleClass="section-title"/>
                <TableView fx:id="memberTable" prefHeight="160"/>

                <Label text="소켓 로그 &amp; 채팅" styleClass="section-title"/>
                <ScrollPane fx:id="console" styleClass="console" fitToWidth="true" prefHeight="260">
                    <VBox fx:id="logBox" spacing="2">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                    </VBox>
                </ScrollPane>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="chatInput" promptText="메시지를 입력하고 Enter"
                               HBox.hgrow="ALWAYS" onAction="#handleSend"/>
                    <Button text="전송" onAction="#handleSend"/>
                </HBox>
            </VBox>

            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <VBox fx:id="mergedBox" styleClass="panel" spacing="8">
                    <Label text="참여자 전원 조건 병합 결과" styleClass="section-title"/>
                </VBox>

                <Label text="추천 후보" styleClass="section-title"/>
                <VBox fx:id="candidateBox" spacing="10"/>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="closeRoomButton" text="방 종료" onAction="#handleCloseRoom"/>
                    <Button fx:id="resultButton" text="최종 결과" styleClass="primary"
                            onAction="#handleResult"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
